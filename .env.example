# Copy to .env in the repo root (gitignored; never commit real values).
# cli.py and scripts/check_token_factory.py load its TOKEN_FACTORY_* lines;
# variables already exported in the shell take precedence.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Nemotron model IDs per retry tier: attempt 1, 2, 3+ (exact catalog casing;
# scripts/check_token_factory.py prints them)
TOKEN_FACTORY_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
TOKEN_FACTORY_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
TOKEN_FACTORY_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
